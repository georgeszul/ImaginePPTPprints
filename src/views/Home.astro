---
import Page from '../layouts/Page.astro';
import Figure from '../components/Figure.astro';
import SectionHead from '../components/SectionHead.astro';
import Ticket from '../components/Ticket.astro';
import ProcessTicket from '../components/ProcessTicket.astro';
import ColorBar from '../components/ColorBar.astro';
import RegMark from '../components/RegMark.astro';
import Glyph from '../components/Glyph.astro';
import ContactSheet from '../components/ContactSheet.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Coupon from '../components/Coupon.astro';
import { coverFor, type Category } from '../data/photos';
import { site } from '../data/site';
import { routes, type Lang, type PageKey } from '../i18n/routes';
import { t, tRaw } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
const facts = tRaw<{ label: string; value: string }[]>(lang, 'home.hero.facts');
const services = tRaw<{ key: Category; title: string; body: string }[]>(lang, 'home.services.items');
// Promises the hero facts and the process don't already make; a row with `page` links to that page.
const promises = tRaw<{ label: string; value: string; page?: PageKey }[]>(lang, 'home.proof.rows')
  .map(({ page, ...row }) => ({ ...row, href: page && routes[page][lang] }));
const heroPhoto = coverFor('shirts')!;
const newTab = t(lang, 'site.newTab');
---
<Page lang={lang} page="home" title={t(lang, 'home.meta.title')} description={t(lang, 'home.meta.description')}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="head">
      <p class="kicker"><RegMark /> <span class="kicker-no" aria-hidden="true">01 ·</span> {t(lang, 'home.hero.kicker')}</p>
      <h1 id="hero-title">{t(lang, 'home.hero.title')}</h1>
    </div>
    <Figure photo={heroPhoto} lang={lang} n={1} crop eager ratio="4 / 5" sizes="(max-width: 860px) 100vw, 520px" class="hero-fig" />
    <div class="body">
      <p class="lead">{t(lang, 'home.hero.lead')}</p>
      <div class="btn-row" data-contact-buttons="lead">
        <a class="btn btn--ink" href={routes.contact[lang]}>{t(lang, 'site.quote')}</a>
        <a class="btn btn--line" href={site.whatsapp} target="_blank" rel="noopener"><Glyph name="chat" />{t(lang, 'site.cta.whatsapp')}<span class="visually-hidden">{newTab}</span></a>
      </div>
      <Ticket rows={facts} class="facts" />
      <ColorBar class="hero-bar" />
    </div>
  </section>

  <ContactSheet lang={lang} />

  <section class="sec" aria-labelledby="services-title">
    <div class="wrap">
      <div class="reveal">
        <SectionHead n={3} id="services-title" title={t(lang, 'home.services.title')} lead={t(lang, 'home.services.lead')} />
      </div>
      <ServiceIndex lang={lang} items={services} />
      <p class="after"><a class="btn btn--ink" href={`${routes.services[lang]}#calculator`}>{t(lang, 'home.services.more')}</a></p>
    </div>
  </section>

  <section class="sec" aria-labelledby="how-title">
    <div class="wrap">
      <div class="reveal">
        <SectionHead n={4} id="how-title" title={t(lang, 'home.how.title')} />
      </div>
      <ProcessTicket lang={lang} />
    </div>
  </section>

  <section class="sec sec--tight" aria-labelledby="proof-title">
    <div class="wrap split">
      <div class="reveal">
        <SectionHead n={5} id="proof-title" title={t(lang, 'home.proof.title')} />
        <a class="btn btn--line" href={site.facebook} target="_blank" rel="noopener">{t(lang, 'home.proof.reviews')}<Glyph name="out" /><span class="visually-hidden">{newTab}</span></a>
      </div>
      <Ticket rows={promises} class="promises" />
    </div>
  </section>

  <section class="sec sec--tint" aria-labelledby="cta-title">
    <div class="wrap close">
      <div class="close-head reveal">
        <SectionHead n={6} id="cta-title" title={t(lang, 'home.cta.title')} lead={t(lang, 'home.cta.body')} />
      </div>
      <Coupon lang={lang} class="close-coupon" />
      <div class="btn-row close-btns" data-contact-buttons>
        <a class="btn btn--yellow" href={site.phoneHref}><Glyph name="phone" />{site.phone}</a>
        <a class="btn btn--cyan" href={site.whatsapp} target="_blank" rel="noopener"><Glyph name="chat" />{t(lang, 'site.cta.whatsapp')}<span class="visually-hidden">{newTab}</span></a>
        <a class="btn btn--line" href={`mailto:${site.email}`}><Glyph name="mail" />{t(lang, 'site.cta.email')}</a>
      </div>
    </div>
  </section>
</Page>

<style>
  /* The label is a flex row; keep the section number "01 ·" from splitting inside its own item on narrow phones. */
  .kicker-no { white-space: nowrap; flex-shrink: 0; }
  /* Hero: headline and offer on the left; one large print with crop marks on the right, its frame on the grid
     (the crop marks hang into the gutter). Phones stack headline, photo, then the offer, so the first screen shows the work. */
  .hero {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto 1fr;
    column-gap: clamp(1rem, 3vw, 2.5rem); align-items: start;
    padding-block: clamp(2.5rem, 6vw, 5.5rem) var(--sec);
  }
  .head, .body { grid-column: 1 / span 7; }
  .hero :global(.hero-fig) { grid-column: 8 / -1; grid-row: 1 / span 2; margin-top: 0.9rem; }
  /* The one oversized element on the page. */
  .hero h1 { margin-bottom: 1.5rem; font-size: clamp(3.25rem, 7.5vw + 1rem, 8.25rem); }
  .hero .lead { margin-bottom: 2rem; }
  .hero :global(.facts) { margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 34rem; }
  .hero :global(.hero-bar) { max-width: 34rem; margin-top: 1.5rem; }
  @media (max-width: 860px) {
    .hero { grid-template-columns: minmax(0, 1fr); grid-template-rows: none; }
    .head, .body, .hero :global(.hero-fig) { grid-column: 1; grid-row: auto; }
    .hero :global(.hero-fig) { margin: 0 0 2rem; }
    .hero :global(.hero-fig .frame) { aspect-ratio: 3 / 2; }
  }

  .after { margin: clamp(2rem, 4vw, 3rem) 0 0; }

  /* Proof: heading and the reviews link beside a short job ticket of promises. */
  .split { display: grid; gap: 2rem clamp(2rem, 5vw, 5rem); align-items: start; }
  @media (min-width: 1024px) {
    .split { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }

  /* Closing call to action: invitation and buttons, with the coupon alongside. */
  .close { display: grid; gap: 2.5rem clamp(2rem, 6vw, 6rem); grid-template-areas: 'head' 'coupon' 'btns'; }
  .close-head { grid-area: head; }
  .close-head :global(.sec-head) { margin-bottom: 0; }
  .close :global(.close-coupon) { grid-area: coupon; }
  .close-btns { grid-area: btns; }
  @media (min-width: 960px) {
    .close { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-areas: 'head coupon' 'btns coupon'; align-items: start; }
    .close :global(.close-coupon) { align-self: center; }
  }
</style>
