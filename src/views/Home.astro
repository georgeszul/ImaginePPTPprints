---
import Page from '../layouts/Page.astro';
import Figure from '../components/Figure.astro';
import SectionHead from '../components/SectionHead.astro';
import Ticket from '../components/Ticket.astro';
import ColorBar from '../components/ColorBar.astro';
import RegMark from '../components/RegMark.astro';
import Glyph from '../components/Glyph.astro';
import ContactSheet from '../components/ContactSheet.astro';
import ServiceIndex from '../components/ServiceIndex.astro';
import Coupon from '../components/Coupon.astro';
import { coverFor, type Category } from '../data/photos';
import { site } from '../data/site';
import { routes, type Lang } from '../i18n/routes';
import { t, tRaw } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
const facts = tRaw<{ label: string; value: string }[]>(lang, 'home.hero.facts');
const services = tRaw<{ key: Category; title: string; body: string }[]>(lang, 'home.services.items');
const steps = tRaw<{ title: string; body: string }[]>(lang, 'home.how.steps');
const proof = tRaw<string[]>(lang, 'home.proof.items');
const heroPhoto = coverFor('shirts')!;
---
<Page lang={lang} page="home" title={t(lang, 'home.meta.title')} description={t(lang, 'home.meta.description')}>
  <section class="hero wrap" aria-labelledby="hero-title">
    <div class="copy">
      <p class="kicker"><RegMark /> {t(lang, 'home.hero.kicker')}</p>
      <h1 id="hero-title">{t(lang, 'home.hero.title')}</h1>
      <p class="lead">{t(lang, 'home.hero.lead')}</p>
      <div class="btn-row">
        <a class="btn btn--ink" href={routes.contact[lang]}>{t(lang, 'site.quote')}</a>
        <a class="btn btn--line" href={site.whatsapp} target="_blank" rel="noopener"><Glyph name="chat" />{t(lang, 'site.cta.whatsapp')}</a>
      </div>
      <Ticket rows={facts} class="facts" />
      <ColorBar class="hero-bar" />
    </div>
    <Figure photo={heroPhoto} lang={lang} n={1} crop eager ratio="4 / 5" sizes="(max-width: 860px) 100vw, 520px" class="hero-fig" />
  </section>

  <ContactSheet lang={lang} />

  <section class="sec" aria-labelledby="services-title">
    <div class="wrap">
      <div class="reveal">
        <SectionHead n={3} id="services-title" title={t(lang, 'home.services.title')} lead={t(lang, 'home.services.lead')} />
      </div>
      <ServiceIndex lang={lang} items={services} />
      <p class="after"><a class="btn btn--ink" href={routes.services[lang]}>{t(lang, 'home.services.more')}</a></p>
    </div>
  </section>

  <section class="sec" aria-labelledby="how-title">
    <div class="wrap">
      <div class="reveal">
        <SectionHead n={4} id="how-title" title={t(lang, 'home.how.title')} />
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class="step reveal">
            <p class="mono label">{t(lang, 'home.how.step')} {i + 1}</p>
            <span class="corner"><RegMark size={18} /></span>
            <h3>{s.title}</h3>
            <p>{s.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="sec" aria-labelledby="proof-title">
    <div class="wrap split">
      <div class="reveal">
        <SectionHead n={5} id="proof-title" title={t(lang, 'home.proof.title')} />
        <a class="btn btn--line" href={site.facebook} target="_blank" rel="noopener">{t(lang, 'home.proof.reviews')}<Glyph name="out" /></a>
      </div>
      <ul class="proof">
        {proof.map((item) => <li><Glyph name="check" />{item}</li>)}
      </ul>
    </div>
  </section>

  <section class="sec sec--tint" aria-labelledby="cta-title">
    <div class="wrap close">
      <div class="close-head reveal">
        <SectionHead n={6} id="cta-title" title={t(lang, 'home.cta.title')} lead={t(lang, 'home.cta.body')} />
      </div>
      <Coupon lang={lang} class="close-coupon" />
      <div class="btn-row close-btns">
        <a class="btn btn--yellow" href={site.phoneHref}><Glyph name="phone" />{site.phone}</a>
        <a class="btn btn--cyan" href={site.whatsapp} target="_blank" rel="noopener"><Glyph name="chat" />{t(lang, 'site.cta.whatsapp')}</a>
        <a class="btn btn--line" href={`mailto:${site.email}`}><Glyph name="mail" />{t(lang, 'site.cta.email')}</a>
      </div>
    </div>
  </section>
</Page>

<style>
  /* Hero: headline, offer and facts on the left; one large print with crop marks on the right. */
  .hero {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1rem, 3vw, 2.5rem); row-gap: 3rem;
    align-items: start; padding-block: clamp(2.5rem, 6vw, 5.5rem) var(--sec);
  }
  .copy { grid-column: 1 / span 7; }
  .hero :global(.hero-fig) { grid-column: 8 / -1; margin: 0.9rem 14px 0 0; }
  /* The one oversized element on the page. */
  .hero h1 { margin-bottom: 1.5rem; font-size: clamp(3.25rem, 7.5vw + 1rem, 8.25rem); }
  .hero .lead { margin-bottom: 2rem; }
  .hero :global(.facts) { margin-top: clamp(2.5rem, 5vw, 3.5rem); max-width: 34rem; }
  .hero :global(.hero-bar) { max-width: 34rem; margin-top: 1.5rem; }
  @media (max-width: 860px) {
    .copy, .hero :global(.hero-fig) { grid-column: 1 / -1; }
    .hero :global(.hero-fig) { margin: 0 14px; }
  }

  .after { margin: clamp(2rem, 4vw, 3rem) 0 0; }

  /* How it works: one job ticket split into three parts by perforations. */
  .steps { list-style: none; margin: 0; padding: 0; display: grid; border: 1px solid var(--rule); }
  .step { position: relative; padding: clamp(1.25rem, 3vw, 2rem); }
  .step + .step { border-top: 1px dashed var(--rule); }
  .label { margin: 0 0 clamp(2rem, 5vw, 4rem); color: var(--ink-soft); text-transform: uppercase; }
  .corner { position: absolute; top: clamp(1.25rem, 3vw, 2rem); right: clamp(1.25rem, 3vw, 2rem); display: inline-flex; }
  .step h3 { margin-bottom: 0.5rem; }
  .step p:last-child { margin: 0; color: var(--ink-soft); }
  @media (min-width: 720px) {
    .steps { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .step + .step { border-top: 0; border-left: 1px dashed var(--rule); }
  }

  /* Proof: heading and reviews link beside a ruled list of plain facts. */
  .split { display: grid; gap: 2rem clamp(2rem, 5vw, 5rem); }
  .proof { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--rule); align-self: start; }
  .proof li { display: flex; gap: 0.75rem; align-items: baseline; padding-block: 1rem; border-bottom: 1px solid var(--rule); font-weight: 600; }
  .proof li :global(svg) { flex: none; translate: 0 0.2em; }
  @media (min-width: 720px) {
    .proof { grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: 2rem; }
  }
  @media (min-width: 1024px) {
    .split { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); }
  }

  /* Closing call to action: invitation and buttons, with the coupon alongside. */
  .close { display: grid; gap: 2.5rem clamp(2rem, 6vw, 6rem); grid-template-areas: 'head' 'coupon' 'btns'; }
  .close-head { grid-area: head; }
  .close-head :global(.sec-head) { margin-bottom: 0; }
  .close :global(.close-coupon) { grid-area: coupon; }
  .close-btns { grid-area: btns; }
  @media (min-width: 960px) {
    .close { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-areas: 'head coupon' 'btns coupon'; align-items: start; }
    .close :global(.close-coupon) { align-self: center; }
  }
</style>
