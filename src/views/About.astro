---
import Page from '../layouts/Page.astro';
import SectionHead from '../components/SectionHead.astro';
import Figure from '../components/Figure.astro';
import Ticket from '../components/Ticket.astro';
import Glyph from '../components/Glyph.astro';
import { coverFor, photos } from '../data/photos';
import { site } from '../data/site';
import type { Lang } from '../i18n/routes';
import { t, tRaw } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
const a = (key: string) => t(lang, `about.${key}`);
const [intro, ...paragraphs] = tRaw<string[]>(lang, 'about.story.paragraphs');
// A high-resolution team order (1536px wide); the sticker photos are only 206px and blur at this size.
const photo = photos.find((p) => p.src.src.includes('tees-team-teddy-bear')) ?? coverFor('shirts')!;

type Link = { href: string; label: string; external?: boolean };
const contact: { label: string; text?: string; links: Link[]; note?: string }[] = [
  { label: a('contact.address'), text: site.addressLine, links: [{ href: site.mapsUrl, label: a('contact.directions'), external: true }] },
  { label: a('contact.phone'), links: [{ href: site.phoneHref, label: site.phone }], note: a('contact.phoneNote') },
  { label: a('contact.email'), links: [{ href: `mailto:${site.email}`, label: site.email }] },
  { label: a('contact.store'), links: [{ href: site.shopify, label: a('contact.storeLink'), external: true }] },
  {
    label: a('contact.social'),
    // Facebook appears once, under Reviews.
    links: [{ href: site.tiktok, label: a('contact.tiktok'), external: true }],
  },
  { label: a('contact.reviews'), links: [{ href: site.facebook, label: a('contact.reviewsLink'), external: true }] },
];
---
<Page lang={lang} page="about" title={a('meta.title')} description={a('meta.description')}>
  <section class="head wrap" aria-labelledby="about-title">
    <SectionHead n={1} id="about-title" title={a('title')} lead={a('lead')} level={1} />
  </section>

  <section class="sec" aria-labelledby="story-title">
    <div class="wrap story">
      <div class="text">
        <SectionHead n={2} id="story-title" title={a('story.title')} />
        <p class="lead intro">{intro}</p>
        {paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <Figure class="photo reveal" photo={photo} lang={lang} n={1} crop ratio="4 / 5"
        sizes="(min-width: 1280px) 480px, (min-width: 860px) 38vw, calc(100vw - 2rem)" />
      <div class="spanish">
        <p class="tag mono" lang="es">{t(lang, 'site.spanish')}</p>
        <h3>{a('language.title')}</h3>
        <p>{a('language.body')}</p>
      </div>
    </div>
  </section>

  <section class="sec sec--tint" aria-labelledby="find-title">
    <div class="wrap">
      <SectionHead n={3} id="find-title" title={a('contact.title')} />
      <div class="find">
        <div class="hours reveal">
          <div class="hours-body">
            <h3>{a('hours.title')}</h3>
            <Ticket rows={[{ label: a('hours.days'), value: a('hours.value') }]} />
            <p>{a('hours.delivery')}</p>
          </div>
        </div>
        <dl class="contact reveal">
          {contact.map((row) => (
            <div>
              <dt class="mono">{row.label}</dt>
              <dd>
                {row.text && <address>{row.text}</address>}
                {row.links.map((l) => {
                  // The last word and the arrow stay on one line, so the arrow never wraps alone.
                  const cut = l.external ? l.label.lastIndexOf(' ') + 1 : l.label.length;
                  return (
                    <a href={l.href} target={l.external ? '_blank' : undefined} rel={l.external ? 'noopener' : undefined}>
                      <span>{l.label.slice(0, cut)}{l.external && <span class="nw">{l.label.slice(cut)}<Glyph name="out" size={16} /></span>}</span>
                      {l.external && <span class="visually-hidden"> {t(lang, 'site.newTab')}</span>}
                    </a>
                  );
                })}
                {row.note && <span class="note">{row.note}</span>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</Page>

<style>
  /* 01 Page head: headline left, lead set against its baseline on wide screens. */
  .head { padding-block: clamp(3rem, 8vw, 6.5rem) clamp(2.5rem, 5vw, 4rem); }
  .head :global(.sec-head) { margin: 0; }
  .head :global(.lead) { margin: 0; }
  @media (min-width: 860px) {
    .head :global(.sec-head) {
      display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 24rem); column-gap: 4rem; align-items: end;
    }
    .head :global(.kicker) { grid-column: 1 / -1; }
    .head :global(h1) { margin: 0; }
    .head :global(.lead) { padding-bottom: 0.6rem; }
  }

  /* 02 Story: text and the Spanish note on the left, the photo on the right. */
  .story { display: grid; gap: clamp(2.5rem, 5vw, 3.5rem); grid-template-areas: 'text' 'photo' 'spanish'; }
  .text { grid-area: text; }
  .text p { max-width: 58ch; }
  .text :global(.sec-head) { margin-bottom: 1.5rem; }
  .intro { color: var(--ink); }
  .text p:last-child { margin-bottom: 0; }
  .story :global(.photo) { grid-area: photo; }
  @media (min-width: 860px) {
    .story {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); grid-template-rows: auto 1fr;
      grid-template-areas: 'text photo' 'spanish photo'; column-gap: clamp(3rem, 7vw, 7rem);
    }
    .spanish { align-self: start; }
  }

  /* Dashed frame with its label set into the border, like a stamp on a proof sheet. */
  .spanish { grid-area: spanish; position: relative; max-width: 40rem; margin-top: 0.75rem; padding: 2rem clamp(1.25rem, 3vw, 2rem) 1.5rem; border: 2px dashed var(--ink); }
  .tag { position: absolute; top: 0; left: clamp(1rem, 3vw, 1.75rem); margin: 0; padding: 0 0.6rem; transform: translateY(-55%); background: var(--paper); }
  .spanish h3 { margin-bottom: 0.5rem; }
  .spanish p:last-child { margin: 0; }

  /* 03 Find us: an hours ticket beside the contact rows. */
  .find { display: grid; gap: clamp(2.5rem, 5vw, 4rem); align-items: start; }
  @media (min-width: 860px) { .find { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); column-gap: clamp(3rem, 7vw, 7rem); } }

  .hours { background: var(--paper); border: 1.5px solid var(--ink); }
  .hours-body { padding: clamp(1.25rem, 3vw, 2rem); }
  .hours :global(.ticket) { margin-block: 1rem 1.25rem; }
  .hours .hours-body :global(.ticket div) { grid-template-columns: 1fr; gap: 0.3rem; padding-block: 1rem; }
  .hours :global(.ticket dd) {
    font: 700 clamp(1.9rem, 2vw + 1.3rem, 2.75rem)/1 var(--font-display); letter-spacing: -0.03em; font-stretch: 85%;
  }
  .hours p { margin: 0; color: var(--ink-soft); }

  .contact { margin: 0; border-top: 1px solid var(--rule); }
  .contact > div {
    display: grid; grid-template-columns: minmax(8rem, 30%) 1fr; column-gap: 1rem; align-items: baseline;
    padding-block: 0.35rem; border-bottom: 1px solid var(--rule);
  }
  .contact dt { color: var(--ink-soft); text-transform: uppercase; }
  .contact dd { display: flex; flex-wrap: wrap; align-items: baseline; column-gap: 1.5rem; margin: 0; }
  .contact address { flex-basis: 100%; padding-top: 0.6rem; font-style: normal; font-weight: 600; }
  /* Inline-block, not flex, so the arrow follows the last word when a long label wraps. */
  .contact a {
    display: inline-block; min-height: 44px; padding-block: 0.55rem;
    color: var(--ink); font-weight: 600; text-decoration: none;
  }
  .nw { white-space: nowrap; }
  .contact a > span {
    text-decoration: underline; text-decoration-thickness: 1px; text-underline-offset: 0.2em;
    transition: text-decoration-thickness 200ms var(--ease-out);
  }
  .contact a :global(svg) { display: inline; margin-left: 0.35rem; vertical-align: -0.15em; }
  @media (hover: hover) and (pointer: fine) { .contact a:hover > span { text-decoration-thickness: 3px; } }
  .note { color: var(--ink-soft); }
  @media (max-width: 520px) {
    .contact > div { grid-template-columns: 1fr; padding-block: 0.75rem 0.25rem; }
    .contact address { padding-top: 0.25rem; }
  }
</style>
