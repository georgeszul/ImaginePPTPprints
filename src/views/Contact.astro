---
import Page from '../layouts/Page.astro';
import SectionHead from '../components/SectionHead.astro';
import ColorBar from '../components/ColorBar.astro';
import Glyph from '../components/Glyph.astro';
import QuoteOrder from '../components/QuoteOrder.astro';
import FaqList from '../components/FaqList.astro';
import { site } from '../data/site';
import type { Lang } from '../i18n/routes';
import { t, tRaw } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
const c = (key: string) => t(lang, `contact.${key}`);
const newTab = t(lang, 'site.newTab');
const lists = (['delivery', 'turnaround'] as const).map((key) => ({
  key,
  title: c(`${key}.title`),
  items: tRaw<string[]>(lang, `contact.${key}.items`),
}));
// Brand names stay untranslated when a visitor runs the page through a translator.
const follow = [
  { href: site.facebook, label: 'Facebook', brand: true },
  { href: site.tiktok, label: 'TikTok', brand: true },
  { href: site.shopify, label: c('follow.shop'), brand: false },
];
// The same questions as the FAQ below, as schema.org FAQPage data for search results.
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: tRaw<{ q: string; a: string }[]>(lang, 'faq.items').map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---
<Page lang={lang} page="contact" title={c('meta.title')} description={c('meta.description')} schema={[faqSchema]}>
  <section class="sec sec--tint order" aria-labelledby="contact-title">
    <div class="wrap head">
      <SectionHead level={1} n={1} id="contact-title" title={c('title')} lead={c('lead')} />
    </div>

    <div class="wrap grid">
      <div class="sheet">
        <ColorBar />
        <div class="slip-head">
          <h2 id="order-title">{c('formTitle')}</h2>
          <p>{c('form.requiredNote')}</p>
        </div>
        <div class="sheet-body">
          <QuoteOrder lang={lang} />
        </div>
      </div>

      <aside class="side" aria-labelledby="direct-title">
        <h2 id="direct-title">{c('info.title')}</h2>
        <dl class="ticket">
          <div><dt class="mono">{c('info.phone')}</dt><dd><a href={site.phoneHref}>{site.phone}</a></dd></div>
          <div><dt class="mono">{c('info.whatsapp')}</dt><dd><a href={site.whatsapp} target="_blank" rel="noopener">{c('info.whatsappValue')}<span class="visually-hidden"> {newTab}</span></a></dd></div>
          <div><dt class="mono">{c('info.email')}</dt><dd><a href={`mailto:${site.email}`}>{site.email}</a></dd></div>
          <div>
            <dt class="mono">{c('info.address')}</dt>
            <dd>{site.addressLine}<br /><a href={site.mapsUrl} target="_blank" rel="noopener">{c('info.directions')}<span class="visually-hidden"> {newTab}</span></a></dd>
          </div>
          <div><dt class="mono">{c('info.hours')}</dt><dd>{c('info.hoursValue')}</dd></div>
        </dl>
        <div class="lists">
          {lists.map((l) => (
            <section aria-labelledby={`${l.key}-title`}>
              <h3 id={`${l.key}-title`} class="mono">{l.title}</h3>
              <ul>{l.items.map((item) => <li>{item}</li>)}</ul>
            </section>
          ))}
        </div>
        <section aria-labelledby="follow-title">
          <h3 id="follow-title" class="mono">{c('follow.title')}</h3>
          <ul class="follow">
            {follow.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener">
                  <span translate={l.brand ? 'no' : undefined}>{l.label}</span><Glyph name="out" size={16} /><span class="visually-hidden"> {newTab}</span>
                </a>
              </li>
            ))}
          </ul>
        </section>
      </aside>
    </div>
  </section>

  <FaqList lang={lang} n={2} />
</Page>

<style>
  /* One tinted band holds the headline and the order sheet, so the first field shows without scrolling on a laptop. */
  .order { padding-block: clamp(1.75rem, 3.5vw, 2.75rem) clamp(3.5rem, 7vw, 6rem); }
  .head :global(.sec-head) { margin-bottom: clamp(1.5rem, 3vw, 2.25rem); }
  .head :global(.kicker) { margin-bottom: 0.75rem; }
  .head :global(h1) { margin: 0; }
  .head :global(.lead) { margin: 0.75rem 0 0; }
  /* From 960px the lead sits beside the headline, over the sidebar column, sharing the headline's last baseline. */
  @media (min-width: 960px) {
    .head :global(.sec-head) {
      display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(2rem, 4vw, 4rem); align-items: last baseline;
    }
    .head :global(.kicker) { grid-column: 1 / -1; }
    .head :global(h1) { grid-column: span 7; }
    .head :global(.lead) { grid-column: span 5; margin: 0; }
  }

  .grid { display: grid; gap: clamp(3rem, 6vw, 4.5rem) clamp(2rem, 4vw, 4rem); align-items: start; }
  @media (min-width: 960px) {
    .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .sheet { grid-column: span 7; }
    .side { grid-column: span 5; position: sticky; top: calc(var(--header-h) + 1rem); }
  }

  /* The order form is a printed sheet on the desk: color bar along the top edge, crop marks just outside its corners.
     Its frames use --ink-soft so they still show on the dark desk. */
  .sheet { --pad: clamp(1.25rem, 4vw, 2.75rem); position: relative; background: var(--paper); border: 1px solid var(--ink-soft); }
  .sheet::after {
    --m: var(--ink); content: ''; position: absolute; inset: -15px; pointer-events: none;
    background:
      linear-gradient(var(--m), var(--m)) 0 14px / 9px 1px, linear-gradient(var(--m), var(--m)) 14px 0 / 1px 9px,
      linear-gradient(var(--m), var(--m)) 100% 14px / 9px 1px, linear-gradient(var(--m), var(--m)) calc(100% - 14px) 0 / 1px 9px,
      linear-gradient(var(--m), var(--m)) 0 calc(100% - 14px) / 9px 1px, linear-gradient(var(--m), var(--m)) 14px 100% / 1px 9px,
      linear-gradient(var(--m), var(--m)) 100% calc(100% - 14px) / 9px 1px, linear-gradient(var(--m), var(--m)) calc(100% - 14px) 100% / 1px 9px;
    background-repeat: no-repeat;
  }
  /* Slip header, like the price calculator's order ticket: the form's name on the left, the required-field key on the right. */
  .slip-head {
    display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 0.25rem 1.5rem;
    padding: 0.9rem var(--pad); border-bottom: 1px solid var(--ink-soft);
    font: 500 var(--small)/1.4 var(--font-mono); letter-spacing: 0.02em; text-transform: uppercase;
  }
  .slip-head h2 { margin: 0; font: inherit; letter-spacing: inherit; }
  .slip-head p { margin: 0; color: var(--ink-soft); }
  .sheet-body { padding: calc(var(--pad) * 0.75) var(--pad) var(--pad); }

  .side h2 { font-size: clamp(1.6rem, 1.2vw + 1.2rem, 2.1rem); line-height: 1.05; margin-bottom: 1rem; }
  .ticket { margin: 0 0 1.75rem; border-top: 2px solid var(--ink); }
  .ticket div {
    display: grid; grid-template-columns: minmax(6.5rem, 34%) minmax(0, 1fr); gap: 1rem;
    padding: 0.2rem 0; border-bottom: 1px solid var(--rule);
  }
  .ticket dt { padding-top: 0.75rem; color: var(--ink-soft); text-transform: uppercase; }
  .ticket dd { margin: 0; padding-block: 0.45rem; font-weight: 600; overflow-wrap: anywhere; }
  .ticket dd:has(> a:first-child) { padding-top: 0; }
  .ticket a { display: inline-flex; align-items: center; min-height: 44px; }

  .lists { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(min(13rem, 100%), 1fr)); margin-bottom: 1.75rem; }
  .side h3 { margin: 0 0 0.6rem; color: var(--ink-soft); text-transform: uppercase; }
  .side ul { list-style: none; margin: 0; padding: 0; }
  .lists li { padding: 0.45rem 0; border-top: 1px solid var(--rule); }
  .lists li:last-child { border-bottom: 1px solid var(--rule); }

  .follow { display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .follow a {
    display: inline-flex; align-items: center; gap: 0.4rem; min-height: 44px; padding: 0 0.9rem;
    border: 1.5px solid var(--ink); color: var(--ink); text-decoration: none; font-weight: 600;
    transition: transform var(--press) var(--ease-out);
  }
  .follow a:active { transform: scale(0.97); }
  @media (hover: hover) and (pointer: fine) {
    .follow a:hover { background: var(--ink); color: var(--paper); }
  }
</style>
