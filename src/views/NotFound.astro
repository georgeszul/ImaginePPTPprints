---
import Page from '../layouts/Page.astro';
import ColorBar from '../components/ColorBar.astro';
import RegMark from '../components/RegMark.astro';
import { routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Page lang={lang} page={null} title={t(lang, 'notfound.meta.title')} description={t(lang, 'notfound.meta.description')} noindex>
  <section class="msg wrap">
    <p class="kicker"><RegMark /> {t(lang, 'notfound.kicker')}</p>
    <h1>{t(lang, 'notfound.title')}</h1>
    <p class="lead">{t(lang, 'notfound.body')}</p>
    <div class="btn-row">
      <a class="btn btn--ink" href={routes.home[lang]}>{t(lang, 'notfound.home')}</a>
      <a class="btn btn--line" href={routes.contact[lang]}>{t(lang, 'notfound.contact')}</a>
    </div>
    <ColorBar class="bar" />
  </section>
</Page>

<style>
  .msg { min-height: 70svh; display: grid; align-content: center; gap: 1.5rem; padding-block: var(--sec); }
  .msg h1, .msg p { margin: 0; }
  .msg h1 { max-width: 14ch; }
  .msg :global(.bar) { max-width: 18rem; margin-top: 1rem; }
</style>
