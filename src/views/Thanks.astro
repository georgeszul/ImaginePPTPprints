---
import Page from '../layouts/Page.astro';
import RegMark from '../components/RegMark.astro';
import Glyph from '../components/Glyph.astro';
import { site } from '../data/site';
import { routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
---
<Page lang={lang} page="thanks" title={t(lang, 'thanks.meta.title')} description={t(lang, 'thanks.meta.description')} noindex>
  <section class="msg wrap">
    <p class="kicker"><RegMark /> {t(lang, 'thanks.kicker')}</p>
    <h1>{t(lang, 'thanks.title')}</h1>
    <p class="lead">{t(lang, 'thanks.body')}</p>
    <p>{t(lang, 'thanks.urgent')}</p>
    <div class="btn-row">
      <a class="btn btn--yellow" href={site.phoneHref}><Glyph name="phone" />{site.phone}</a>
      <a class="btn btn--cyan" href={site.whatsapp} target="_blank" rel="noopener"><Glyph name="chat" />{t(lang, 'site.dock.whatsapp')}<span class="visually-hidden"> {t(lang, 'site.newTab')}</span></a>
      <a class="btn btn--line" href={routes.home[lang]}>{t(lang, 'thanks.back')}</a>
    </div>
  </section>
</Page>

<style>
  .msg { min-height: 70svh; display: grid; align-content: center; gap: 1.5rem; padding-block: var(--sec); }
  .msg h1, .msg p { margin: 0; }
  .msg h1 { max-width: 14ch; }
</style>
