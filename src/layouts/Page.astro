---
import '@fontsource-variable/bricolage-grotesque/standard.css';
import '@fontsource-variable/instrument-sans/standard.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/tokens.css';
import '../styles/base.css';
import bricolage from '@fontsource-variable/bricolage-grotesque/files/bricolage-grotesque-latin-standard-normal.woff2?url';
import instrument from '@fontsource-variable/instrument-sans/files/instrument-sans-latin-standard-normal.woff2?url';
import { getImage } from 'astro:assets';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactDock from '../components/ContactDock.astro';
import logo from '../assets/logo.jpg';
import { site } from '../data/site';
import { coverFor } from '../data/photos';
import { routes, langs, type Lang, type PageKey } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props {
  lang: Lang;
  page: PageKey | null;
  title: string;
  description: string;
  noindex?: boolean;
  /** Extra schema.org objects for this page (for example the FAQ on Contact). */
  schema?: Record<string, unknown>[];
}
const { lang, page, title, description, noindex = false, schema = [] } = Astro.props;
const abs = (path: string) => new URL(path, Astro.site).href;
const paths = page !== null && !noindex ? routes[page] : null;
const canonical = paths ? abs(paths[lang]) : undefined;
// Social preview: a 1200x630 crop of the hero shirt photo (the size Facebook, X and WhatsApp expect).
const hero = coverFor('shirts');
const og = hero
  ? await getImage({ src: hero.src, width: 1200, height: 630, fit: 'cover', format: 'jpg' })
  : await getImage({ src: logo, width: 1200, height: 1200, format: 'jpg' });
const ogAlt = hero ? hero.alt[lang] : site.name;
// Penguin favicon and home-screen icon, generated from the logo at build time.
const favicon = await getImage({ src: logo, width: 64, height: 64, format: 'png' });
const touchIcon = await getImage({ src: logo, width: 180, height: 180, format: 'png' });
const jsonLd =
  page === 'home'
    ? {
        '@context': 'https://schema.org',
        '@type': 'LocalBusiness',
        name: site.name,
        url: abs('/'),
        image: abs(og.src),
        telephone: '+1-331-255-5330',
        email: site.email,
        address: {
          '@type': 'PostalAddress',
          streetAddress: site.street,
          addressLocality: site.locality,
          addressRegion: site.region,
          postalCode: site.postalCode,
          addressCountry: site.country,
        },
        openingHours: 'Mo-Su 00:00-23:59',
        areaServed: 'Elgin, IL',
        knowsLanguage: ['en', 'es'],
        sameAs: [site.facebook, site.tiktok, site.shopify],
        hasOfferCatalog: {
          '@type': 'OfferCatalog',
          name: t(lang, 'site.nav.services'),
          itemListElement: (['shirts', 'hoodies', 'hats', 'banners', 'cards', 'stickers'] as const).map((c) => ({
            '@type': 'Offer',
            itemOffered: { '@type': 'Service', name: t(lang, `site.categories.${c}`), url: abs(`${routes.services[lang]}#${c}`) },
          })),
        },
      }
    : null;
const schemas = [jsonLd, ...schema].filter(Boolean);
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <link rel="preload" href={bricolage} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={instrument} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    {paths && langs.map((l) => <link rel="alternate" hreflang={l} href={abs(paths[l])} />)}
    {paths && <link rel="alternate" hreflang="x-default" href={abs(paths.en)} />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f3ec" />
    <link rel="icon" href={favicon.src} type="image/png" sizes="64x64" />
    <link rel="apple-touch-icon" href={touchIcon.src} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={abs(og.src)} />
    <meta property="og:image:width" content={String(og.attributes.width ?? 1200)} />
    <meta property="og:image:height" content={String(og.attributes.height ?? 630)} />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(og.src)} />
    <meta name="twitter:image:alt" content={ogAlt} />
    <meta property="og:locale" content={lang === 'es' ? 'es_US' : 'en_US'} />
    {canonical && <meta property="og:url" content={canonical} />}
    <script is:inline>
      (function () {
        var root = document.documentElement;
        var theme = null;
        root.classList.add('js');
        try { theme = localStorage.getItem('theme'); } catch (e) {}
        if (theme !== 'light' && theme !== 'dark') {
          theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        root.setAttribute('data-theme', theme);
        // Browser bar matches --paper (runs before the stylesheet loads, so the two values are spelled out).
        document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'dark' ? '#121212' : '#f6f3ec');
        // iOS Safari only applies :active (press feedback) once a touch listener exists.
        document.addEventListener('touchstart', function () {}, { passive: true });
      })();
    </script>
    {/* `<` is escaped so no string in the data can close the script tag early. */}
    {schemas.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip" href="#main">{t(lang, 'site.skip')}</a>
    <SiteHeader lang={lang} page={page} />
    <main id="main" tabindex="-1"><slot /></main>
    <SiteFooter lang={lang} />
    {/* Contact and Thanks show these actions in the page itself, so the floating buttons stay away. */}
    {page !== 'contact' && page !== 'thanks' && <ContactDock lang={lang} />}
  </body>
</html>
