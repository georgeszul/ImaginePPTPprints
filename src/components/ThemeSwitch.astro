---
import Glyph from './Glyph.astro';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
const label = t(lang, 'site.theme');
---
<button type="button" class="theme" data-theme-toggle aria-pressed="false" aria-label={label} title={label}>
  <span class="sun"><Glyph name="sun" /></span>
  <span class="moon"><Glyph name="moon" /></span>
</button>

<style>
  .theme {
    display: inline-grid; place-items: center; width: 44px; height: 44px; padding: 0;
    border: 1.5px solid var(--ink); border-radius: 0; background: transparent; color: var(--ink); cursor: pointer;
    transition: transform var(--press) var(--ease-out);
  }
  .theme:active { transform: scale(0.97); }
  /* Sun and moon share one cell and crossfade instead of popping. */
  .theme > span { grid-area: 1 / 1; display: inline-flex; transition: opacity 200ms var(--ease-out), rotate 200ms var(--ease-out); }
  .sun { opacity: 0; rotate: -45deg; }
  :global([data-theme='dark']) .sun { opacity: 1; rotate: 0deg; }
  :global([data-theme='dark']) .moon { opacity: 0; rotate: 45deg; }
</style>

<script>
  const root = document.documentElement;
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => {
      btn.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(root).getPropertyValue('--paper').trim());
    };
    sync();
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage blocked (private mode): the choice lasts for this page view only.
      }
      sync();
    });
  }
</script>
