---
// One service as an editorial spread: photo (or a blank "your design here" proof) beside its spec sheet.
import { Image } from 'astro:assets';
import Figure from './Figure.astro';
import Ticket from './Ticket.astro';
import RegMark from './RegMark.astro';
import logo from '../assets/logo.jpg';
import { coverFor, type Category } from '../data/photos';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props {
  lang: Lang;
  service: { id: Category; title: string; intro: string; specs: { label: string; value: string }[]; bullets: string[] };
  n: number;
  flip: boolean;
}
const { lang, service, n, flip } = Astro.props;
const photo = coverFor(service.id);
const num = String(n).padStart(2, '0');
---
<article id={service.id} class:list={['spread', { flip, bare: !photo }]}>
  <div class="media">
    {photo ? (
      <Figure photo={photo} lang={lang} n={n} crop ratio="4 / 3" sizes="(max-width: 860px) 100vw, 640px" class="reveal" />
    ) : (
      <figure class="blank reveal">
        <div class="design-here">
          <Image src={logo} alt="" width={120} height={120} densities={[1, 2]} />
          <span class="mono">{t(lang, 'site.designHere')}</span>
        </div>
        <figcaption class="mono">{t(lang, 'site.fig')} {num} — {t(lang, `site.categories.${service.id}`)}</figcaption>
      </figure>
    )}
  </div>
  <div class="text">
    <p class="num mono" aria-hidden="true"><RegMark /> {num}</p>
    <h2>{service.title}</h2>
    <p class="intro">{service.intro}</p>
    <Ticket rows={service.specs} />
    {service.bullets.length > 0 && (
      <>
        <p class="kicker details">{t(lang, 'services.details')}</p>
        <ul>{service.bullets.map((b) => <li>{b}</li>)}</ul>
      </>
    )}
  </div>
</article>

<style>
  .spread { grid-column: 1 / -1; display: grid; align-content: start; gap: 2rem; padding-block: clamp(2.5rem, 6vw, 5rem); border-top: 1px solid var(--rule); }
  .text { min-width: 0; }
  .num { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1.25rem; }
  .num::after { content: ''; flex: 1; height: 1px; background: var(--rule); }
  h2 { margin-bottom: 0.5em; }
  .intro { font-size: calc(var(--text) * 1.1); color: var(--ink-soft); max-width: 40ch; margin-bottom: 1.75rem; }
  .details { margin: 2rem 0 0.75rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  li { display: flex; gap: 0.75rem; }
  /* Small cyan plate mark instead of a bullet. */
  li::before { content: ''; flex: none; width: 0.55em; height: 0.55em; margin-top: 0.55em; background: var(--cyan); outline: 1px solid var(--ink); }

  /* No photo yet: a blank proof with a dashed print area, the penguin and crop marks. */
  .blank { margin: 0; container-type: inline-size; }
  .design-here {
    position: relative; aspect-ratio: 4 / 3; display: grid; place-content: center; justify-items: center; gap: 1rem;
    background: var(--paper-2); border: 1px solid var(--rule); text-align: center;
  }
  .design-here::before { content: ''; position: absolute; inset: 12%; border: 1px dashed var(--ink-soft); pointer-events: none; }
  .design-here img { position: relative; width: clamp(72px, 20cqi, 120px); height: auto; border-radius: 50%; border: 1px solid var(--ink); }
  .design-here span { position: relative; padding: 0 1rem; text-transform: uppercase; }
  .design-here::after {
    --m: var(--ink); content: ''; position: absolute; inset: -15px; pointer-events: none;
    background:
      linear-gradient(var(--m), var(--m)) 0 14px / 9px 1px, linear-gradient(var(--m), var(--m)) 14px 0 / 1px 9px,
      linear-gradient(var(--m), var(--m)) 100% 14px / 9px 1px, linear-gradient(var(--m), var(--m)) calc(100% - 14px) 0 / 1px 9px,
      linear-gradient(var(--m), var(--m)) 0 calc(100% - 14px) / 9px 1px, linear-gradient(var(--m), var(--m)) 14px 100% / 1px 9px,
      linear-gradient(var(--m), var(--m)) 100% calc(100% - 14px) / 9px 1px, linear-gradient(var(--m), var(--m)) calc(100% - 14px) 100% / 1px 9px;
    background-repeat: no-repeat;
  }
  .blank figcaption { margin-top: 0.6rem; color: var(--ink-soft); }

  @media (min-width: 861px) {
    .spread:not(.bare) { grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(1.5rem, 3.5vw, 3.5rem); align-items: start; }
    .spread:not(.bare) > * { grid-row: 1; }
    .spread:not(.bare) .media { grid-column: 1 / span 7; }
    .spread:not(.bare) .text { grid-column: 8 / -1; }
    .spread.flip:not(.bare) .media { grid-column: 6 / -1; }
    .spread.flip:not(.bare) .text { grid-column: 1 / span 5; }
    /* Services without a photo pair up side by side, proof above text. */
    .bare { grid-column: auto; }
  }
</style>
