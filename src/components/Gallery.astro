---
import { getImage } from 'astro:assets';
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { photos, categories } from '../data/photos';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
const items = await Promise.all(
  photos.map(async (p) => {
    const width = Math.min(1600, p.src.width);
    return {
      p,
      width,
      height: Math.round((p.src.height * width) / p.src.width),
      full: (await getImage({ src: p.src, width, format: 'webp' })).src,
    };
  }),
);
---
<div class="filters" role="group" aria-label={t(lang, 'portfolio.filterLabel')} data-filters>
  <button type="button" aria-pressed="true" data-filter="all">{t(lang, 'portfolio.filters.all')}</button>
  {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c}>{t(lang, `portfolio.filters.${c}`)}</button>)}
</div>

<ul class="gallery" data-gallery>
  {items.map(({ p }) => (
    <li class="reveal" data-category={p.category}>
      <button type="button" class="thumb" aria-label={`${t(lang, 'portfolio.open')}: ${p.alt[lang]}`}>
        <Photo photo={p} lang={lang} sizes="(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 280px" />
      </button>
    </li>
  ))}
</ul>

<!-- One slide per photo, in the same order as the grid. Swiping is native scroll-snap, so momentum and edge bounce come from the browser. -->
<dialog class="viewer" data-viewer aria-label={t(lang, 'portfolio.open')}>
  <ul class="slides" data-slides>
    {items.map(({ p, full, width, height }) => (
      <li data-category={p.category}><img src={full} alt={p.alt[lang]} width={width} height={height} loading="lazy" decoding="async" style={`max-width: min(100%, ${width * 2}px); max-height: min(100%, ${height * 2}px)`} /></li>
    ))}
  </ul>
  <button type="button" class="arrow-btn prev" data-step="-1" aria-label={t(lang, 'portfolio.prev')}><Icon name="arrow" /></button>
  <button type="button" class="arrow-btn next" data-step="1" aria-label={t(lang, 'portfolio.next')}><Icon name="arrow" /></button>
  <button type="button" class="btn btn--primary close" data-close>{t(lang, 'portfolio.close')}</button>
</dialog>

<style>
  .filters { display: none; flex-wrap: wrap; gap: 0.5rem; justify-content: center; margin-bottom: 2rem; }
  :global(.js) .filters { display: flex; }
  .filters button {
    min-height: 44px; padding: 0.5rem 1rem; cursor: pointer;
    border: 2px solid var(--line); border-radius: 999px; background: var(--surface-2); color: var(--ink);
    font: 600 1rem/1 'Fredoka', system-ui, sans-serif;
  }
  .filters button:hover { background: var(--surface); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .gallery { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(240px, 45%), 1fr)); }
  .gallery li[hidden] { display: none; }
  .thumb {
    display: block; width: 100%; aspect-ratio: 1; padding: 0; cursor: zoom-in;
    border: 2px solid var(--line); border-radius: 18px; overflow: hidden; background: var(--surface);
    transition: transform 0.15s ease;
  }
  .thumb:hover { transform: translateY(-3px); }
  .thumb:active { transform: scale(0.97); transition-duration: 0.08s; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }

  .viewer {
    width: min(94vw, 1100px); height: min(90dvh, 900px); max-width: none; max-height: none;
    padding: 0; overflow: hidden; border: 3px solid #111; border-radius: 20px; background: var(--surface-2);
  }
  .viewer::backdrop { background: rgb(0 0 0 / 0.75); }
  .viewer[open]::backdrop { animation: backdrop-in 0.25s ease-out; }
  @keyframes backdrop-in { from { opacity: 0; } }
  .slides {
    display: flex; height: 100%; margin: 0; padding: 0; list-style: none;
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .slides::-webkit-scrollbar { display: none; }
  .slides li { flex: 0 0 100%; min-width: 0; display: grid; place-items: center; padding: 4rem 0.75rem 0.75rem; scroll-snap-align: center; scroll-snap-stop: always; }
  .slides li[hidden] { display: none; }
  /* Fill the slide but never upscale past 2x, so small source photos stay sharp enough. */
  .slides img { width: 100%; height: 100%; object-fit: contain; }
  .arrow-btn {
    position: absolute; top: 50%; width: 48px; height: 48px; display: grid; place-items: center; cursor: pointer;
    border: 2px solid #111; border-radius: 50%; background: var(--accent); color: #111; box-shadow: 3px 3px 0 #111;
    translate: 0 -50%; transition: transform 0.1s ease, box-shadow 0.1s ease;
  }
  .arrow-btn:active { transform: translate(2px, 2px); box-shadow: 1px 1px 0 #111; }
  .prev { left: 0.75rem; }
  .prev :global(svg) { rotate: 180deg; }
  .next { right: 0.75rem; }
  .close { position: absolute; top: 0.75rem; right: 0.75rem; }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const viewer = document.querySelector<HTMLDialogElement>('[data-viewer]');
  const slides = viewer?.querySelector<HTMLElement>('[data-slides]');
  const cells = gallery ? [...gallery.querySelectorAll<HTMLElement>(':scope > li')] : [];
  const thumbs = cells.map((li) => li.querySelector<HTMLButtonElement>('.thumb')!);
  const slideEls = slides ? [...slides.querySelectorAll<HTMLElement>(':scope > li')] : [];
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');

  if (filters) {
    const apply = (f: string) => {
      for (const b of filters.querySelectorAll<HTMLElement>('[data-filter]')) b.setAttribute('aria-pressed', String(b.dataset.filter === f));
      cells.forEach((li, i) => {
        li.hidden = f !== 'all' && li.dataset.category !== f;
        if (slideEls[i]) slideEls[i].hidden = li.hidden;
      });
    };
    filters.addEventListener('click', (e) => {
      const f = (e.target as Element).closest<HTMLButtonElement>('[data-filter]')?.dataset.filter;
      if (!f) return;
      apply(f);
      // Keep the filter in the URL so a filtered view can be shared or bookmarked.
      const url = new URL(location.href);
      if (f === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', f);
      history.replaceState(null, '', url);
    });
    const initial = new URLSearchParams(location.search).get('category');
    if (initial && filters.querySelector(`[data-filter="${CSS.escape(initial)}"]`)) apply(initial);
  }

  if (gallery && viewer && slides) {
    const visible = () => slideEls.filter((s) => !s.hidden);
    const currentIndex = () => slideEls.indexOf(visible()[Math.round(slides.scrollLeft / slides.clientWidth)] ?? visible()[0]);
    let closing = false;
    let returnTo: HTMLElement | null = null;

    // Grow the dialog out of the tapped thumbnail (and shrink back into it), so the photo keeps its place in space.
    const morph = (thumb: HTMLElement, dir: 'in' | 'out') => {
      if (reduce.matches) return null;
      const a = thumb.getBoundingClientRect();
      const b = viewer.getBoundingClientRect();
      const dx = a.left + a.width / 2 - (b.left + b.width / 2);
      const dy = a.top + a.height / 2 - (b.top + b.height / 2);
      const frames = [{ transform: `translate(${dx}px, ${dy}px) scale(${a.width / b.width})`, opacity: 0.5 }, { transform: 'none', opacity: 1 }];
      if (dir === 'out') {
        frames.reverse();
        try { viewer.animate({ opacity: [1, 0] }, { duration: 240, pseudoElement: '::backdrop', fill: 'forwards' }); } catch {}
      }
      return viewer.animate(frames, { duration: dir === 'in' ? 360 : 240, easing: 'cubic-bezier(0.2, 0.9, 0.25, 1)', fill: dir === 'out' ? 'forwards' : 'none' });
    };

    const close = () => {
      if (closing || !viewer.open) return;
      closing = true;
      returnTo = thumbs[currentIndex()] ?? null;
      const r = returnTo?.getBoundingClientRect();
      const onScreen = r && r.bottom > 0 && r.top < innerHeight;
      const anim = returnTo && onScreen ? morph(returnTo, 'out') : null;
      const done = () => {
        viewer.close();
        for (const a of viewer.getAnimations({ subtree: true })) a.cancel();
        closing = false;
      };
      if (anim) anim.finished.then(done, done);
      else done();
    };

    const step = (dir: number) => slides.scrollBy({ left: dir * slides.clientWidth, behavior: reduce.matches ? 'auto' : 'smooth' });

    gallery.addEventListener('click', (e) => {
      const thumb = (e.target as Element).closest<HTMLButtonElement>('.thumb');
      if (!thumb) return;
      viewer.showModal();
      slides.scrollLeft = visible().indexOf(slideEls[thumbs.indexOf(thumb)]) * slides.clientWidth;
      morph(thumb, 'in');
    });
    viewer.addEventListener('click', (e) => {
      const target = e.target as Element;
      const stepBtn = target.closest<HTMLElement>('[data-step]');
      if (stepBtn) step(Number(stepBtn.dataset.step));
      else if (target.closest('[data-close]') || target === viewer || target.parentElement === slides) close();
    });
    viewer.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        step(e.key === 'ArrowRight' ? 1 : -1);
      }
    });
    // Esc: run the same animated close instead of the dialog's instant one.
    viewer.addEventListener('cancel', (e) => {
      e.preventDefault();
      close();
    });
    viewer.addEventListener('close', () => returnTo?.focus());
  }
</script>
