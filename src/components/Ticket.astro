---
// Job-ticket rows: mono label, value. Used for hero facts, service specs and contact details.
interface Props { rows: { label: string; value: string; href?: string }[]; class?: string }
const { rows, class: className } = Astro.props;
---
<dl class:list={['ticket', className]}>
  {rows.map((r) => <div><dt class="mono">{r.label}</dt><dd>{r.href ? <a href={r.href}>{r.value}</a> : r.value}</dd></div>)}
</dl>

<style>
  .ticket { margin: 0; border-top: 1px solid var(--rule); }
  .ticket div { display: grid; grid-template-columns: minmax(7rem, 38%) minmax(0, 1fr); gap: 1rem; padding: 0.7rem 0; border-bottom: 1px solid var(--rule); }
  dt { color: var(--ink-soft); text-transform: uppercase; }
  /* minmax(0, 1fr) + anywhere: long values such as an email address wrap instead of overflowing. */
  dd { margin: 0; font-weight: 600; overflow-wrap: anywhere; }
  dd a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
