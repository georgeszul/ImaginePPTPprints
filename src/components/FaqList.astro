---
import SectionHead from './SectionHead.astro';
import type { Lang } from '../i18n/routes';
import { t, tRaw } from '../i18n/t';

interface Props { lang: Lang; n: number }
const { lang, n } = Astro.props;
// `lang` marks an item written in another language; `en` is its English line (the Spanish-language item is bilingual).
const items = tRaw<{ q: string; a: string; lang?: string; en?: string }[]>(lang, 'faq.items');
---
<section class="sec faq" aria-labelledby="faq">
  <div class="wrap grid">
    <SectionHead n={n} id="faq" title={t(lang, 'faq.title')} />
    <div class="list">
      {items.map((item) => (
        <details lang={item.lang}>
          <summary><span class="q">{item.q}</span><span class="pm" aria-hidden="true"></span></summary>
          <p class="a">{item.a}{item.en && <> <span lang="en">{item.en}</span></>}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .grid { display: grid; gap: 0 2rem; }
  @media (min-width: 960px) {
    .grid { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .grid > :global(.sec-head) { grid-column: 1 / span 4; }
    .list { grid-column: 5 / -1; }
  }
  .list { border-top: 1px solid var(--rule); }
  details { border-bottom: 1px solid var(--rule); }
  summary {
    display: flex; align-items: center; justify-content: space-between; gap: 1.25rem;
    min-height: 44px; padding: 1.1rem 0; cursor: pointer; list-style: none;
    font: 700 var(--h3)/1.2 var(--font-display); letter-spacing: -0.01em; text-wrap: balance;
  }
  summary::-webkit-details-marker { display: none; }
  /* Plus/minus drawn in CSS: the vertical bar turns flat when the answer opens. */
  .pm {
    position: relative; flex: none; width: 44px; height: 44px; border: 1.5px solid var(--ink);
    transition: background-color 200ms var(--ease-out), color 200ms var(--ease-out), scale var(--press) var(--ease-out);
  }
  .pm::before, .pm::after {
    content: ''; position: absolute; left: 50%; top: 50%; width: 14px; height: 2px;
    background: currentColor; translate: -50% -50%;
  }
  .pm::after { rotate: 90deg; transition: rotate 220ms var(--ease-out); }
  details[open] .pm { background: var(--ink); color: var(--paper); }
  details[open] .pm::after { rotate: 0deg; }
  summary:active .pm { scale: 0.97; }
  @media (hover: hover) and (pointer: fine) {
    summary:hover .q { text-decoration: underline; text-decoration-thickness: 2px; text-underline-offset: 0.18em; }
  }
  .a { max-width: 62ch; margin: 0; padding: 0 0 1.5rem; }
  @media (min-width: 600px) { .a { padding-right: calc(44px + 1.25rem); } }

  /* The answer slides open where the browser can animate to auto height; otherwise, and under reduced motion, it opens at once. */
  @supports selector(::details-content) {
    @media (prefers-reduced-motion: no-preference) {
      details { interpolate-size: allow-keywords; }
      details::details-content {
        block-size: 0; overflow-y: clip; opacity: 0;
        transition: block-size 260ms var(--ease-out), opacity 260ms var(--ease-out), content-visibility 260ms allow-discrete;
      }
      details[open]::details-content { block-size: auto; opacity: 1; }
      /* Closing is quicker than opening: the visitor is done with the answer. */
      details:not([open])::details-content { transition-duration: 180ms; }
    }
  }
</style>
