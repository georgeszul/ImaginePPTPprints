---
import Icon from './Icon.astro';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
const label = t(lang, 'common.theme.toggle');
---
<button type="button" class="theme-toggle" data-theme-toggle aria-pressed="false" aria-label={label} title={label}>
  <span class="sun"><Icon name="sun" /></span>
  <span class="moon"><Icon name="moon" /></span>
</button>

<style>
  .theme-toggle {
    display: inline-grid; place-items: center; width: 44px; height: 44px;
    border: 2px solid var(--line); border-radius: 999px;
    background: var(--surface-2); color: var(--ink); cursor: pointer;
  }
  .theme-toggle:hover { background: var(--surface); }
  /* Sun and moon share one cell and crossfade instead of popping. */
  .theme-toggle > span { grid-area: 1 / 1; display: inline-flex; transition: opacity 0.2s ease, transform 0.2s ease; }
  .sun { opacity: 0; transform: rotate(-45deg) scale(0.7); }
  :global([data-theme='dark']) .sun { opacity: 1; transform: none; }
  :global([data-theme='dark']) .moon { opacity: 0; transform: rotate(45deg) scale(0.7); }
</style>

<script>
  const root = document.documentElement;
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]')) {
    const sync = () => {
      btn.setAttribute('aria-pressed', String(root.dataset.theme === 'dark'));
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', getComputedStyle(root).getPropertyValue('--bg').trim());
    };
    sync();
    btn.addEventListener('click', () => {
      const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
      root.dataset.theme = next;
      try {
        localStorage.setItem('theme', next);
      } catch {
        // Storage blocked (private mode): the choice lasts for this page view only.
      }
      sync();
    });
  }
</script>
