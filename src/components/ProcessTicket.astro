---
// The order process, the same four steps on Home and Services: one job-ticket row per step,
// each with its press plate (cyan, magenta, yellow, then key).
import type { Lang } from '../i18n/routes';
import { t, tRaw } from '../i18n/t';

interface Props { lang: Lang; class?: string }
const { lang, class: className } = Astro.props;
const steps = tRaw<{ title: string; body: string }[]>(lang, 'site.process.steps');
const no = t(lang, 'site.process.no');
const num = (i: number) => String(i + 1).padStart(2, '0');
// Ranges such as "24–48" or "24 a 48" (odd indexes after the split) stay on one line in narrow columns.
const parts = (text: string) => text.split(/(\d+(?:–| a )\d+)/);
---
<ol class:list={['steps', className]}>
  {steps.map((s, i) => (
    <li class="step reveal">
      <p class="n mono" aria-hidden="true">{no} {num(i)}<span class="plate"></span></p>
      <h3>{s.title}</h3>
      <p>{parts(s.body).map((p, j) => (j % 2 ? <span class="nw">{p}</span> : p))}</p>
    </li>
  ))}
</ol>

<style>
  .steps { list-style: none; margin: 0; padding: 0; display: grid; border-top: 1px solid var(--rule); border-left: 1px solid var(--rule); }
  @media (min-width: 600px) { .steps { grid-template-columns: 1fr 1fr; } }
  @media (min-width: 1024px) { .steps { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  .step { padding: 1.25rem 1.25rem 1.75rem; border-right: 1px solid var(--rule); border-bottom: 1px solid var(--rule); }
  .n { display: flex; justify-content: space-between; align-items: center; margin: 0 0 2.5rem; color: var(--ink-soft); }
  .plate { width: 14px; height: 14px; outline: 1px solid var(--ink); }
  .step:nth-child(1) .plate { background: var(--cyan); }
  .step:nth-child(2) .plate { background: var(--magenta); }
  .step:nth-child(3) .plate { background: var(--yellow); }
  .step:nth-child(4) .plate { background: var(--ink); }
  h3 { margin-bottom: 0.5rem; }
  .step p:last-child { margin: 0; color: var(--ink-soft); }
  .nw { white-space: nowrap; }
</style>
