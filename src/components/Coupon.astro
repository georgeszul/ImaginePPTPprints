---
// FIRST10 offer drawn as a dashed tear-off coupon.
import Glyph from './Glyph.astro';
import { site } from '../data/site';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props { lang: Lang; class?: string }
const { lang, class: className } = Astro.props;
---
<div class:list={['coupon', className]}>
  <span class="cut"><Glyph name="scissors" size={22} label={t(lang, 'site.coupon.cut')} /></span>
  <p class="kicker">{t(lang, 'site.coupon.kicker')}</p>
  <p class="title">{t(lang, 'site.coupon.title')}</p>
  <p class="body">{t(lang, 'site.coupon.body')} <strong class="code" translate="no">{site.promoCode}</strong></p>
</div>

<style>
  .coupon { position: relative; padding: clamp(1.5rem, 4vw, 2.5rem); border: 2px dashed var(--ink); }
  /* The scissors sit on the dashed line; the patch behind them matches the tinted section. */
  .cut {
    position: absolute; top: -13px; left: clamp(1rem, 3vw, 2rem); display: inline-flex; padding: 0 0.35rem;
    background: var(--paper-2); color: var(--ink);
  }
  .kicker { margin-bottom: 0.75rem; }
  .title {
    margin: 0 0 1rem; font: 800 clamp(3.25rem, 7vw + 1rem, 6rem)/0.9 var(--font-display);
    letter-spacing: -0.04em; font-stretch: 80%;
  }
  .body { margin: 0; max-width: 30ch; }
  .code {
    display: inline-block; margin-top: 0.5rem; padding: 0.3rem 0.6rem;
    background: var(--yellow); color: var(--on-color); border: 2px solid var(--on-color);
    font: 500 1.25rem/1.2 var(--font-mono); letter-spacing: 0.08em;
  }
</style>
