---
import ColorBar from './ColorBar.astro';
import { site } from '../data/site';
import { routes, type Lang } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
const f = (key: string) => t(lang, `site.footer.${key}`);
const year = new Date().getFullYear();
---
<footer class="footer" data-footer>
  <ColorBar />
  <div class="wrap">
    <p class="word" translate="no">{site.name}</p>
    <p class="tagline mono">{t(lang, 'site.tagline')}</p>
    <div class="cols">
      <div class="about">
        <p>{f('about')}</p>
        <p lang="es">{t(lang, 'site.spanish')}</p>
      </div>
      <nav aria-label={f('pages')}>
        <h2 class="mono">{f('pages')}</h2>
        <ul>
          {(['services', 'portfolio', 'about', 'contact'] as const).map((k) => (
            <li><a href={routes[k][lang]}>{t(lang, `site.nav.${k}`)}</a></li>
          ))}
        </ul>
      </nav>
      <div>
        <h2 class="mono">{f('contact')}</h2>
        <ul>
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
          <li><a href={site.mapsUrl} target="_blank" rel="noopener">{site.addressLine}</a></li>
        </ul>
      </div>
      <div>
        <h2 class="mono">{f('follow')}</h2>
        <ul>
          <li><a href={site.facebook} target="_blank" rel="noopener">Facebook</a></li>
          <li><a href={site.tiktok} target="_blank" rel="noopener">TikTok</a></li>
          <li><a href={site.shopify} target="_blank" rel="noopener">{f('shop')}</a></li>
        </ul>
      </div>
    </div>
    <div class="bottom mono">
      <p>© {year} {site.name}. {f('rights')}</p>
      <ul>
        <li><a href={routes.privacy[lang]}>{f('privacy')}</a></li>
        <li><a href={`${routes.privacy[lang]}#cookies`}>{f('cookies')}</a></li>
        <li><a href={routes.terms[lang]}>{f('terms')}</a></li>
        <li><a href={routes.refunds[lang]}>{f('refunds')}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--rule); background: var(--paper); }
  .word {
    margin: clamp(2.5rem, 6vw, 4.5rem) 0 0.5rem;
    font: 700 clamp(2.75rem, 9vw, 7.5rem)/0.9 var(--font-display); letter-spacing: -0.045em; font-stretch: 80%;
  }
  .tagline { margin: 0 0 clamp(2rem, 5vw, 3.5rem); color: var(--ink-soft); text-transform: uppercase; }
  .cols { display: grid; gap: 2rem; grid-template-columns: repeat(auto-fit, minmax(min(200px, 100%), 1fr)); padding-top: 2rem; border-top: 1px solid var(--rule); }
  .about p { color: var(--ink-soft); max-width: 34ch; }
  h2 { margin: 0 0 0.5rem; font-size: var(--small); font-weight: 500; text-transform: uppercase; color: var(--ink-soft); letter-spacing: 0.04em; }
  ul { list-style: none; margin: 0; padding: 0; }
  .cols a { display: inline-block; padding-block: 0.55rem; color: var(--ink); text-decoration: none; }
  @media (hover: hover) and (pointer: fine) { .cols a:hover, .bottom a:hover { text-decoration: underline; } }
  /* Left-aligned so the floating Call/WhatsApp buttons never cover these links. */
  .bottom {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0 1.5rem;
    margin-top: 2.5rem; padding-block: 0.75rem 1.5rem; border-top: 1px solid var(--rule); color: var(--ink-soft);
  }
  .bottom p { margin: 0; }
  .bottom ul { display: flex; flex-wrap: wrap; gap: 0 1.25rem; }
  .bottom a { display: inline-block; padding-block: 0.6rem; color: inherit; text-decoration: none; }
</style>
