---
import { getImage, Picture } from 'astro:assets';
import Glyph from './Glyph.astro';
import { photos, categories } from '../data/photos';
import type { Lang } from '../i18n/routes';
import { t } from '../i18n/t';

interface Props { lang: Lang }
const { lang } = Astro.props;
const items = await Promise.all(
  photos.map(async (p) => {
    const width = Math.min(1600, p.src.width);
    return {
      p,
      width,
      height: Math.round((p.src.height * width) / p.src.width),
      full: (await getImage({ src: p.src, width, format: 'webp' })).src,
    };
  }),
);
// "Fig. 07 — Custom shirts": the number is the photo's place in the full set, so it stays the same when filtered.
const caption = (p: (typeof photos)[number], i: number) => `${t(lang, 'site.fig')} ${String(i + 1).padStart(2, '0')} — ${t(lang, `site.categories.${p.category}`)}`;
const widthsFor = (w: number) => {
  const ws = [400, 800, 1200].filter((x) => x <= w);
  return ws.length ? ws : [w];
};
---
<!-- data-strip: on phones this row scrolls sideways on purpose (QA skips intentional horizontal strips). -->
<div class="filters" role="group" aria-label={t(lang, 'portfolio.filterLabel')} data-filters data-strip>
  <button type="button" aria-pressed="true" data-filter="all">{t(lang, 'portfolio.all')}</button>
  {categories.map((c) => <button type="button" aria-pressed="false" data-filter={c}>{t(lang, `site.categories.${c}`)}</button>)}
</div>
<p class="visually-hidden" role="status" data-count data-one={t(lang, 'portfolio.count.one')} data-other={t(lang, 'portfolio.count.other')}></p>

<ul class="gallery" data-gallery>
  {items.map(({ p }, i) => (
    <li class="reveal" data-category={p.category}>
      <figure class="fig">
        <button type="button" class="thumb" aria-label={`${t(lang, 'portfolio.open')}: ${p.alt[lang]}`}>
          <Picture src={p.src} alt={p.alt[lang]} widths={widthsFor(p.src.width)}
            sizes="(max-width: 600px) 46vw, (max-width: 1000px) 31vw, 300px"
            formats={['avif', 'webp']} fallbackFormat="jpg" loading="lazy" decoding="async" pictureAttributes={{ class: 'frame' }} />
        </button>
        <figcaption class="mono">{caption(p, i)}</figcaption>
      </figure>
    </li>
  ))}
</ul>

<!-- One slide per photo, in the same order as the grid. Swiping is native scroll-snap, so momentum and edge bounce come from the browser. -->
<dialog class="viewer" data-viewer aria-label={t(lang, 'portfolio.viewer')} data-position={t(lang, 'portfolio.position')}>
  <ul class="slides" data-slides>
    {items.map(({ p, full, width, height }, i) => (
      <li data-category={p.category}>
        <img src={full} alt={p.alt[lang]} width={width} height={height} loading="lazy" decoding="async" class:list={[{ small: width < 600 }]} />
        <p class="cap mono"><span>{caption(p, i)}<span class="pos"></span></span></p>
      </li>
    ))}
  </ul>
  <p class="visually-hidden" aria-live="polite" data-status></p>
  <button type="button" class="btn btn--line step prev" data-step="-1" aria-label={t(lang, 'portfolio.prev')}><Glyph name="arrow" /></button>
  <button type="button" class="btn btn--line step next" data-step="1" aria-label={t(lang, 'portfolio.next')}><Glyph name="arrow" /></button>
  <button type="button" class="btn btn--ink close" data-close autofocus><Glyph name="close" />{t(lang, 'portfolio.close')}</button>
</dialog>

<style>
  /* Filters: mono tabs on a hairline. They need the script, so they stay hidden without it. */
  .filters {
    display: none; flex-wrap: wrap; column-gap: clamp(1.25rem, 3vw, 2.5rem);
    margin-bottom: clamp(2rem, 4vw, 3.25rem); border-bottom: 1px solid var(--rule);
  }
  :global(.js) .filters { display: flex; }
  .filters button {
    min-height: 44px; min-width: 44px; padding: 0.7rem 0 0.6rem; margin-bottom: -1px; cursor: pointer;
    border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: none; color: var(--ink-soft);
    font: 500 var(--small)/1.4 var(--font-mono); letter-spacing: 0.02em; white-space: nowrap;
    transition: color 160ms ease, transform var(--press) var(--ease-out);
  }
  .filters button[aria-pressed='true'] { color: var(--ink); border-bottom-color: var(--ink); }
  .filters button:active { transform: scale(0.97); }
  .filters button:focus-visible { outline-offset: 2px; }
  @media (hover: hover) and (pointer: fine) { .filters button:hover { color: var(--ink); } }
  /* Phones: one row that scrolls sideways to the screen edges. The hairline becomes an inset shadow,
     because the scroll box would clip an underline that overlaps a real border; the top padding keeps the focus ring in. */
  @media (max-width: 600px) {
    .filters {
      flex-wrap: nowrap; overflow-x: auto; scroll-snap-type: x proximity; scrollbar-width: none; overscroll-behavior-x: contain;
      margin-inline: calc(-1 * var(--gutter)); padding: 5px var(--gutter) 0; scroll-padding-inline: var(--gutter);
      border-bottom: 0; box-shadow: inset 0 -1px var(--rule);
    }
    .filters::-webkit-scrollbar { display: none; }
    /* flex: none, or the explicit 44px min-width lets labels squash together instead of scrolling. */
    .filters button { flex: none; margin-bottom: 0; scroll-snap-align: start; }
  }

  /* The contact sheet: identical 4:5 boards, each with a hairline and a figure caption. */
  .gallery {
    list-style: none; margin: 0; padding: 0; display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(260px, 46%), 1fr));
    gap: clamp(1.75rem, 3.2vw, 3rem) clamp(1rem, 2.4vw, 2rem);
  }
  .gallery li[hidden] { display: none; }
  .fig { margin: 0; }
  /* Each photo is mounted whole on a paper board, like a proof pinned to a sheet: nothing is cropped. */
  .thumb {
    position: relative; display: block; width: 100%; aspect-ratio: 4 / 5; padding: 0.5rem; cursor: zoom-in;
    border: 0; border-radius: 0; background: var(--paper-2); color: inherit;
    transition: transform var(--press) var(--ease-out);
  }
  .thumb :global(.frame) { display: block; height: 100%; }
  .thumb :global(img) { width: 100%; height: 100%; object-fit: contain; }
  .thumb::after { content: ''; position: absolute; inset: 0; border: 1px solid var(--ink-soft); pointer-events: none; }
  /* Pointing at a frame marks it like a grease-pencil select on a proof sheet: magenta corner brackets. */
  .thumb::before {
    --m: var(--magenta);
    content: ''; position: absolute; inset: -8px; pointer-events: none; opacity: 0;
    background:
      linear-gradient(var(--m), var(--m)) 0 0 / 16px 2px, linear-gradient(var(--m), var(--m)) 0 0 / 2px 16px,
      linear-gradient(var(--m), var(--m)) 100% 0 / 16px 2px, linear-gradient(var(--m), var(--m)) 100% 0 / 2px 16px,
      linear-gradient(var(--m), var(--m)) 0 100% / 16px 2px, linear-gradient(var(--m), var(--m)) 0 100% / 2px 16px,
      linear-gradient(var(--m), var(--m)) 100% 100% / 16px 2px, linear-gradient(var(--m), var(--m)) 100% 100% / 2px 16px;
    background-repeat: no-repeat;
    transition: opacity 160ms ease;
  }
  @media (hover: hover) and (pointer: fine) { .thumb:hover::before { opacity: 1; } }
  .thumb:active { transform: scale(0.97); }
  figcaption { margin-top: 0.7rem; color: var(--ink-soft); }

  /* Viewer: a paper proof on a dimmed desk. Close sits top right; the caption and arrows share the bottom bar,
     lifted above the phone's home indicator. Open and close motion lives in the script. */
  .viewer {
    --bar: max(0.75rem, env(safe-area-inset-bottom, 0px));
    width: min(100vw - 1.5rem, 1200px); height: min(100dvh - 1.5rem, 940px); max-width: none; max-height: none;
    padding: 0; overflow: hidden; border: 1px solid var(--ink-soft); border-radius: 0;
    background: var(--paper); color: var(--ink);
  }
  .viewer::backdrop { background: rgb(0 0 0 / 0.7); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  /* Keep the page behind still while the viewer is open; the reserved gutter stops the layout from shifting. */
  :global(html:has(dialog[data-viewer][open])) { overflow: hidden; scrollbar-gutter: stable; }
  .slides {
    display: flex; height: 100%; margin: 0; padding: 0; list-style: none;
    overflow-x: auto; overflow-y: hidden; scroll-snap-type: x mandatory; overscroll-behavior-x: contain;
    scrollbar-width: none;
  }
  .slides::-webkit-scrollbar { display: none; }
  .slides li {
    /* One definite track, so the photo's 100% height means the slide, not the photo's own size. */
    position: relative; flex: 0 0 100%; min-width: 0; display: grid; grid-template: minmax(0, 1fr) / minmax(0, 1fr); place-items: center;
    padding: 4.5rem 0.75rem calc(4rem + var(--bar)); scroll-snap-align: center; scroll-snap-stop: always;
  }
  .slides li[hidden] { display: none; }
  .slides img { width: 100%; height: 100%; object-fit: contain; }
  /* Never upscale small photos past 2x (a class, not an inline style, so the CSP can block style attributes).
     ponytail: 412px = 2 x the 206px sticker and tent photos, the only sources under 600px; revisit if smaller photos arrive. */
  .slides img.small { max-width: min(100%, 412px); max-height: min(100%, 412px); }
  .cap {
    position: absolute; left: 1rem; right: calc(0.75rem + 96px + 0.5rem + 1rem); bottom: var(--bar);
    min-height: 48px; display: flex; align-items: center; margin: 0; color: var(--ink-soft);
  }
  .step {
    position: absolute; bottom: var(--bar); width: 48px; min-height: 48px; height: 48px; padding: 0; background: var(--paper);
    transition: border-color 160ms ease, transform var(--press) var(--ease-out);
  }
  .step :global(svg) { transition: opacity 160ms ease; }
  /* First and last photo: the arrow fades but keeps focus (aria-disabled, not disabled), so arrow keys keep working.
     Only the glyph and border fade; the focus ring stays at full contrast. */
  .step[aria-disabled='true'] { cursor: default; border-color: color-mix(in srgb, currentColor 30%, transparent); }
  .step[aria-disabled='true'] :global(svg) { opacity: 0.35; }
  .step[aria-disabled='true']:active { transform: none; }
  .step[aria-disabled='true']::after { content: none; }
  .prev { right: calc(0.75rem + 48px + 0.5rem); }
  .prev :global(svg) { rotate: 180deg; }
  .next { right: 0.75rem; }
  .close { position: absolute; top: 0.75rem; right: 0.75rem; }
</style>

<script>
  const gallery = document.querySelector<HTMLElement>('[data-gallery]');
  const filters = document.querySelector<HTMLElement>('[data-filters]');
  const count = document.querySelector<HTMLElement>('[data-count]');
  const viewer = document.querySelector<HTMLDialogElement>('[data-viewer]');
  const slides = viewer?.querySelector<HTMLElement>('[data-slides]');
  const cells = gallery ? [...gallery.querySelectorAll<HTMLElement>(':scope > li')] : [];
  const thumbs = cells.map((li) => li.querySelector<HTMLButtonElement>('.thumb')!);
  const slideEls = slides ? [...slides.querySelectorAll<HTMLElement>(':scope > li')] : [];
  const visible = () => slideEls.filter((s) => !s.hidden);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  const fill = (s: string, vars: Record<string, number>) => s.replace(/\{(\w+)\}/g, (_, k: string) => String(vars[k]));

  if (filters) {
    const apply = (f: string) => {
      for (const b of filters.querySelectorAll<HTMLElement>('[data-filter]')) {
        const on = b.dataset.filter === f;
        b.setAttribute('aria-pressed', String(on));
        // On phones the row scrolls sideways: centre the chosen filter (sideways only, never the page).
        if (on) {
          const r = b.getBoundingClientRect();
          const box = filters.getBoundingClientRect();
          filters.scrollBy({ left: r.left + r.width / 2 - (box.left + box.width / 2), behavior: reduce.matches ? 'instant' : 'smooth' });
        }
      }
      cells.forEach((li, i) => {
        li.hidden = f !== 'all' && li.dataset.category !== f;
        if (slideEls[i]) slideEls[i].hidden = li.hidden;
      });
    };
    filters.addEventListener('click', (e) => {
      const f = (e.target as Element).closest<HTMLButtonElement>('[data-filter]')?.dataset.filter;
      if (!f) return;
      apply(f);
      // Screen readers hear how many photos are left, e.g. "5 photos".
      if (count) {
        const n = visible().length;
        count.textContent = fill((n === 1 ? count.dataset.one : count.dataset.other) ?? '', { n });
      }
      // Keep the filter in the URL so a filtered view can be shared or bookmarked.
      const url = new URL(location.href);
      if (f === 'all') url.searchParams.delete('category');
      else url.searchParams.set('category', f);
      history.replaceState(null, '', url);
    });
    const initial = new URLSearchParams(location.search).get('category');
    if (initial && filters.querySelector(`[data-filter="${CSS.escape(initial)}"]`)) {
      apply(initial);
      // Centre again once the mono font has loaded and the labels have their real widths.
      document.fonts.ready.then(() => apply(initial));
    }
  }

  if (gallery && viewer && slides) {
    const [prev, next] = [...viewer.querySelectorAll<HTMLElement>('[data-step]')];
    const status = viewer.querySelector<HTMLElement>('[data-status]')!;
    const ease = 'cubic-bezier(0.23, 1, 0.32, 1)';
    // The slide we are on or heading to, as an index into the visible slides.
    let target = 0;
    let anims: Animation[] = [];
    let closing = false;
    const thumbAt = (i: number) => thumbs[slideEls.indexOf(visible()[i])] ?? null;

    // Only the current slide is exposed to assistive tech; the end arrows read as disabled.
    const update = () => {
      const vis = visible();
      vis.forEach((s, i) => (s.inert = i !== target));
      prev.setAttribute('aria-disabled', String(target === 0));
      next.setAttribute('aria-disabled', String(target === vis.length - 1));
    };
    // "Fig. 07 — Custom shirts, 7 of 43", the same text as the visible caption.
    const announce = () => {
      const text = visible()[target]?.querySelector('.cap')?.textContent ?? '';
      if (status.textContent !== text) status.textContent = text;
    };
    // Step from the target, not from where the scroll happens to be, so quick repeated presses never drop a slide.
    const go = (i: number, smooth: boolean) => {
      target = Math.max(0, Math.min(visible().length - 1, i));
      slides.scrollTo({ left: target * slides.clientWidth, behavior: smooth && !reduce.matches ? 'smooth' : 'instant' });
      update();
    };
    // After any scroll (arrows, keys or a swipe) settles, sync to the slide on screen.
    const settle = () => {
      if (!viewer.open) return;
      target = Math.round(slides.scrollLeft / slides.clientWidth);
      update();
      announce();
    };
    if ('onscrollend' in window) slides.addEventListener('scrollend', settle);
    else {
      let timer: ReturnType<typeof setTimeout>;
      slides.addEventListener('scroll', () => { clearTimeout(timer); timer = setTimeout(settle, 120); });
    }

    // Grow out of the tapped photo and shrink back into it, so it keeps its place in space.
    // Reduced motion (or a photo scrolled off screen) gets a plain fade.
    const animate = (thumb: HTMLElement | null, out: boolean) => {
      const timing: KeyframeAnimationOptions = { duration: out ? 200 : 280, easing: ease, fill: 'both' };
      const shown = { opacity: 1, transform: 'none' };
      let hidden = { opacity: 0, transform: 'none' };
      if (thumb && !reduce.matches) {
        const a = thumb.getBoundingClientRect();
        const b = viewer.getBoundingClientRect();
        const dx = a.left + a.width / 2 - (b.left + b.width / 2);
        const dy = a.top + a.height / 2 - (b.top + b.height / 2);
        hidden = { opacity: 0, transform: `translate(${dx}px, ${dy}px) scale(${a.width / b.width})` };
      }
      anims = [
        viewer.animate(out ? [shown, hidden] : [hidden, shown], timing),
        viewer.animate({ opacity: out ? [1, 0] : [0, 1] }, { ...timing, pseudoElement: '::backdrop' }),
      ];
    };

    // Pointer close: shrink back into the photo. Closing mid-opening reverses the opening from where it is.
    const close = () => {
      if (closing || !viewer.open) return;
      closing = true;
      if (anims.some((a) => a.playState === 'running')) for (const a of anims) a.reverse();
      else {
        for (const a of anims) a.cancel(); // measure the dialog without the finished opening still applied
        const thumb = thumbAt(target);
        const r = thumb?.getBoundingClientRect();
        animate(r && r.bottom > 0 && r.top < innerHeight ? thumb : null, true);
      }
      // A rejection means Esc closed it first; nothing left to do.
      Promise.all(anims.map((a) => a.finished)).then(() => viewer.close(), () => {});
    };

    gallery.addEventListener('click', (e) => {
      const thumb = (e.target as Element).closest<HTMLButtonElement>('.thumb');
      if (!thumb) return;
      const vis = visible();
      const position = viewer.dataset.position ?? '';
      // No-break spaces keep "7 of 43" on one line; the comma stays with the word before it.
      vis.forEach((s, i) => (s.querySelector('.pos')!.textContent = `, ${fill(position, { n: i + 1, total: vis.length }).replace(/ /g, ' ')}`));
      viewer.showModal(); // focuses the Close button (autofocus)
      target = vis.indexOf(slideEls[thumbs.indexOf(thumb)]);
      slides.scrollLeft = target * slides.clientWidth;
      update();
      animate(thumb, false);
      // Give the live region a moment to join the accessibility tree before it speaks.
      setTimeout(announce, 100);
    });
    viewer.addEventListener('click', (e) => {
      const el = e.target as Element;
      const stepBtn = el.closest<HTMLElement>('[data-step]');
      // detail 0 = Enter or Space on the button: keyboard steps jump, pointer steps glide.
      if (stepBtn) go(target + Number(stepBtn.dataset.step), e.detail > 0);
      else if (el.closest('[data-close]') || el === viewer || el.parentElement === slides) close();
    });
    viewer.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
      e.preventDefault();
      go(target + (e.key === 'ArrowRight' ? 1 : -1), false);
    });
    // Esc uses the dialog's own instant close; every close ends here, back on the photo being viewed.
    viewer.addEventListener('close', () => {
      for (const a of anims) a.cancel();
      anims = [];
      closing = false;
      status.textContent = '';
      thumbAt(target)?.focus();
    });
  }
</script>
